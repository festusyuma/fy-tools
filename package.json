{
  "name": "@fy-tools/source",
  "version": "0.0.119-alpha.101",
  "license": "MIT",
  "scripts": {
    "prepublish": "npx nx run-many -t build --parallel",
    "publish": "npm publish --access public --workspaces"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "22.5.4",
    "@nx/eslint-plugin": "22.5.4",
    "@nx/js": "22.5.4",
    "@nx/node": "22.5.4",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.19",
    "@types/node": "22.19.15",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.5.4",
    "prettier": "^2.6.2",
    "tslib": "^2.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "verdaccio": "6.3.1"
  },
  "workspaces": [
    "packages/*",
    "lib/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  },
  "dependencies": {}
}
